# Used by docker-compose.yml (copy to .env). Backend-only settings live in backend/.env.example
POSTGRES_PASSWORD=atsystem
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Seeds the demo school on first start. Set to false for a real deployment!
SEED_DEMO_DATA=true
